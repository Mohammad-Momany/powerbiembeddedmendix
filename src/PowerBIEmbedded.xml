<?xml version="1.0" encoding="utf-8"?>
<widget id="lowcodeconnect.powerbiembedded.PowerBIEmbedded" pluginWidget="true" needsEntityContext="true" offlineCapable="true" supportedPlatform="Web"
    xmlns="http://www.mendix.com/widget/1.0/"
    xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://www.mendix.com/widget/1.0/ ../node_modules/mendix/custom_widget.xsd">
    <name>Power BI Embed</name>
    <description>Embed a PowerBI Dashboard in a Mendix app</description>
    <icon>
	
    </icon>
    <properties>
        <propertyGroup caption="Report">
            <property key="reportType" type="enumeration" defaultValue="report">
                <caption>Type</caption>
                <description>type of report</description>
                <enumerationValues>
                    <enumerationValue key="report">Report</enumerationValue>
                    <enumerationValue key="dashboard">Dashboard</enumerationValue>
                    <enumerationValue key="tile">Tile</enumerationValue>
                    <enumerationValue key="visual">Visual</enumerationValue>
                    <enumerationValue key="qna">Qna</enumerationValue>
                    <enumerationValue key="paginated_report">Paginated report</enumerationValue>
                </enumerationValues>
            </property>

            <property key="reportIdattr" type="attribute">
                <caption>Id attr</caption>
                <description>Attribute containing Id of the dashboard, report or tile</description>
                <attributeTypes>
                    <attributeType name="String"/>
                </attributeTypes>
            </property>

            <property key="embedURLattr" type="attribute">
                <caption>Embed url attr</caption>
                <description>Attribute containing the embed URL</description>
                <attributeTypes>
                    <attributeType name="String"/>
                </attributeTypes>
            </property>

            <property key="accessTokenattr" type="attribute">
                <caption>Access token attr</caption>
                <description>Attribute containing the access token</description>
                <attributeTypes>
                    <attributeType name="String"/>
                </attributeTypes>
            </property>
        </propertyGroup>

        <propertyGroup caption="Filter1">
            <property key="f1Enable" type="expression" required="true" defaultValue="true">
                <caption>Enable Filter 1</caption>
                <description/>
			 <returnType type="Boolean"/>
			</property>
			<property key="f1Table" type="expression" required="false" defaultValue="">
				<caption>Table Name</caption>
				<description>The table name in Power BI (e.g. Municipalities)</description>
				<returnType type="String"/>
			</property>
			<property key="f1Column" type="expression" required="false" defaultValue="">
				<caption>Column Name</caption>
				<description>The column name (e.g. Name)</description>
				<returnType type="String"/>
			</property>
			<property key="f1Value" type="expression" required="false">
				<caption>Filter Value</caption>
				<description>Select the Mendix attribute holding the value</description>
				<returnType type="String"/>
			</property>
			<property key="f1Operator" type="enumeration" defaultValue="In">
				<caption>Operator</caption>
				<description>Choose how to filter the data</description>
				<enumerationValues>
					<enumerationValue key="In">Is (In)</enumerationValue>
					<enumerationValue key="NotIn">Is Not (NotIn)</enumerationValue>
					<enumerationValue key="Contains">Contains</enumerationValue>
					<enumerationValue key="StartsWith">Starts With</enumerationValue>
				</enumerationValues>
			</property>
			<property key="f1Locked" type="boolean" defaultValue="true">
				<caption>Lock Filter</caption>
				<description>If Yes, user cannot change this filter</description>
			</property>
			<property key="f1Hidden" type="boolean" defaultValue="true">
				<caption>Hide Filter</caption>
				<description>If Yes, the filter card is hidden from the side pane</description>
			</property>
		</propertyGroup>
		<propertyGroup caption="Filter2">
            <property key="f2Enable" type="expression" required="true" defaultValue="false">
                <caption>Enable Filter 2</caption>
                <description/>
			 <returnType type="Boolean"/>
			</property>
			<property key="f2Table" type="expression" required="false" defaultValue="">
				<caption>Table Name</caption>
				<description>The table name in Power BI (e.g. Municipalities)</description>
				<returnType type="String"/>
			</property>
			<property key="f2Column" type="expression" required="false" defaultValue="">
				<caption>Column Name</caption>
				<description>The column name (e.g. Name)</description>
				<returnType type="String"/>
			</property>
			<property key="f2Value" type="expression" required="false">
				<caption>Filter Value</caption>
				<description>Select the Mendix attribute holding the value</description>
				<returnType type="String"/>
			</property>
			<property key="f2Operator" type="enumeration" defaultValue="In">
				<caption>Operator</caption>
				<description>Choose how to filter the data</description>
				<enumerationValues>
					<enumerationValue key="In">Is (In)</enumerationValue>
					<enumerationValue key="NotIn">Is Not (NotIn)</enumerationValue>
					<enumerationValue key="Contains">Contains</enumerationValue>
					<enumerationValue key="StartsWith">Starts With</enumerationValue>
				</enumerationValues>
			</property>
			<property key="f2Locked" type="boolean" defaultValue="true">
				<caption>Lock Filter</caption>
				<description>If Yes, user cannot change this filter</description>
			</property>
			<property key="f2Hidden" type="boolean" defaultValue="true">
				<caption>Hide Filter</caption>
				<description>If Yes, the filter card is hidden from the side pane</description>
			</property>
		</propertyGroup>

        <propertyGroup caption="Appearance">
            <property key="filterPaneEnabled" type="boolean" defaultValue="false">
                <caption>Show filters</caption>
                <description>Show the filter panel</description>
            </property>
            <property key="navContentPaneEnabled" type="boolean" defaultValue="false">
                <caption>Show navigation</caption>
                <description>Show the navigation panel</description>
            </property>
        </propertyGroup>

    </properties>
</widget>